<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Vein.Ue4ss.DumpLog</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Vein Dump Manager</AssemblyName>
    <AssemblyTitle>Vein Dump Manager</AssemblyTitle>
    <Product>Vein Dump Manager</Product>
    <FileDescription>VEIN dump manager and UE4SS live log monitor</FileDescription>
    <ApplicationIcon>Assets\vein-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\vein-cheat-engine-dump-workflow\Start-VEIN-CheatEngineDump.ps1">
      <Link>tools\vein-cheat-engine-dump-workflow\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\vein-cheat-engine-dump-workflow\VEIN_MasterDump_Throttled.lua">
      <Link>tools\vein-cheat-engine-dump-workflow\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
